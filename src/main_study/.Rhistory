df_wide = df_merged %>%
select(group_id, model_name, condition, version, prompt_type, response_z) %>%
unnest() %>%
pivot_wider(names_from = c(model_name),
values_from = response_z)
### reshape data
df_wide = df_merged %>%
select(group_id, model_name, condition, version, prompt_type, response_z) %>%
unnest(version) %>%
pivot_wider(names_from = c(model_name),
values_from = response_z)
cols = df_wide %>%
select(-group_id,
-condition,
-version,
-prompt_type)
cor_matrix <- cor(cols, use = "complete.obs")
cols
cols = df_wide %>%
select(-group_id,
-condition,
-version,
-prompt_type)
cor_matrix <- cor(cols, use = "complete.obs")
cols = df_wide %>%
ungroup() %>%
select(-group_id,
-condition,
-version,
-prompt_type)
cor_matrix <- cor(cols, use = "complete.obs")
# Plot the correlation matrix
ggcorrplot(cor_matrix,
hc.order = TRUE,
method = "square"
)
View(cols)
cor_matrix
View(cor_matrix)
